{
  "name": "@story-pilot/sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/main.ts",
    "prebuild": "pnpm --filter @story-pilot/contracts build",
    "predev": "pnpm --filter @story-pilot/contracts build",
    "pretest": "pnpm --filter @story-pilot/contracts build",
    "pretypecheck": "pnpm --filter @story-pilot/contracts build",
    "start": "node dist/main.js",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@story-pilot/contracts": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
