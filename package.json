{
  "name": "story-pilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.15.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @story-pilot/desktop dev",
    "dev:desktop": "pnpm --filter @story-pilot/desktop dev",
    "dev:sidecar": "pnpm --filter @story-pilot/sidecar dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:specs",
    "verify:longform": "pnpm --filter @story-pilot/testing run longform",
    "verify:production": "pnpm verify && pnpm verify:longform",
    "verify:specs": "node scripts/verify-production-specs.mjs",
    "test": "pnpm --filter @story-pilot/contracts build && pnpm --filter @story-pilot/presets build && pnpm -r --if-present test",
    "typecheck": "pnpm --filter @story-pilot/contracts build && pnpm --filter @story-pilot/presets build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
